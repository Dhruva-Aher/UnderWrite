# DataHub Configuration
UNDERWRITE_GMS_URL="http://localhost:8080"
UNDERWRITE_DATAHUB_TOKEN="your_personal_access_token_here"

# DataHub UI base, used by the deployment gate to print browsable entity links.
UNDERWRITE_DATAHUB_UI_URL="http://localhost:9002"

# Policy Configuration
UNDERWRITE_POLICY_PATH="policies.yaml"
UNDERWRITE_MAX_LINEAGE_DEPTH=6

# Overrides are a privileged exception to a blocked decision and stay disabled
# until a secret is provisioned here.
# UNDERWRITE_OVERRIDE_TOKEN=""

# OpenAI Configuration
UNDERWRITE_OPENAI_API_KEY="sk-..."
